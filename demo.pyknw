# ==========================================
# ไฟล์ตัวอย่าง PyKNW Studio (.pyknw)
# ==========================================

import sys
import math

def main():
    print("ยินดีต้อนรับสู่ PyKNW Studio!")
    print(f"เวอร์ชัน Python: {sys.version.split()[0]}")
    print("------------------------------------------")
    
    # คำนวณทางคณิตศาสตร์
    radius = 5
    area = math.pi * (radius ** 2)
    print(f"พื้นที่วงกลมรัศมี {radius} หน่วย คือ: {area:.2f}")
    
    # รายการผลลัพธ์
    items = ["เครื่องมือแก้ไขโค้ด Monaco", "รัน Python ในตัวไม่ต้องติดตั้ง", "นามสกุลไฟล์เฉพาะ .pyknw", "ระบบป้องกันการคัดลอกจากภายนอก"]
    print("\nคุณสมบัติเด่นของโปรแกรม:")
    for idx, item in enumerate(items, 1):
        print(f"  {idx}. {item}")
        
    print("\nการประมวลผลเสร็จสิ้นสมบูรณ์")

if __name__ == "__main__":
    main()
